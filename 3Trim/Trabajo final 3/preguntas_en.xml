<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE test [
  <!ELEMENT test (question+)>
  <!ELEMENT question (wording,choices)>
  <!ELEMENT wording (#PCDATA)>
  <!ELEMENT choices (choice+)>
  <!ELEMENT choice (#PCDATA)>
 
  <!ATTLIST question id CDATA #REQUIRED>
  <!ATTLIST choice correct (yes|no) 'no'>
]>
<test>
    <question id="1">
        <wording>What does XML mean?</wording>
        <choices>
            <choice correct="yes">Extensible Markup Language</choice>
            <choice>No Meaning Language</choice>
            <choice>Example Markup Language</choice>
            <choice>Extended Machine Language</choice>
        </choices>
    </question>

    <question id="2">
        <wording>What is a DTD?</wording>
        <choices>
            <choice correct="yes">A schema that defines the structure of an XML</choice>
            <choice>A binary data file</choice>
            <choice>A programming language</choice>
            <choice>A type of HTML tag</choice>
        </choices>
    </question>

    <question id="3">
        <wording>What does the attribute "correct" indicate?</wording>
        <choices>
            <choice correct="yes">Whether an answer is the correct one</choice>
            <choice>The order of the question</choice>
            <choice>The data type</choice>
            <choice>The language of the test</choice>
        </choices>
    </question>

    <question id="4">
        <wording>What does #PCDATA mean?</wording>
        <choices>
            <choice correct="yes">Parsed Character Data</choice>
            <choice>Private Character Data</choice>
            <choice>Public Content Data</choice>
            <choice>Protected Character Data</choice>
        </choices>
    </question>

    <question id="5">
        <wording>Which element contains the answers?</wording>
        <choices>
            <choice correct="yes">choices</choice>
            <choice>answers</choice>
            <choice>options</choice>
            <choice>response</choice>
        </choices>
    </question>

    <question id="6">
        <wording>How many correct answers must there be?</wording>
        <choices>
            <choice correct="yes">One</choice>
            <choice>Two</choice>
            <choice>Three</choice>
            <choice>Four</choice>
        </choices>
    </question>

    <question id="7">
        <wording>Which attribute identifies a question?</wording>
        <choices>
            <choice correct="yes">id</choice>
            <choice>name</choice>
            <choice>qid</choice>
            <choice>ref</choice>
        </choices>
    </question>

    <question id="8">
        <wording>Which element contains the text of the question?</wording>
        <choices>
            <choice correct="yes">wording</choice>
            <choice>text</choice>
            <choice>label</choice>
            <choice>title</choice>
        </choices>
    </question>

    <question id="9">
        <wording>What does it mean that XML is extensible?</wording>
        <choices>
            <choice correct="yes">That it allows defining new tags</choice>
            <choice>That it uses less memory</choice>
            <choice>That it is faster</choice>
            <choice>That it is a compiled language</choice>
        </choices>
    </question>

    <question id="10">
        <wording>What is used to validate an XML?</wording>
        <choices>
            <choice correct="yes">A DTD or an XML Schema</choice>
            <choice>A CSS file</choice>
            <choice>A JSON file</choice>
            <choice>An SQL file</choice>
        </choices>
    </question>

    <question id="11">
        <wording>What type of language is XML?</wording>
        <choices>
            <choice correct="yes">A markup language</choice>
            <choice>A programming language</choice>
            <choice>A query language</choice>
            <choice>A style language</choice>
        </choices>
    </question>

    <question id="12">
        <wording>What does the + symbol mean in a DTD?</wording>
        <choices>
            <choice correct="yes">One or more elements</choice>
            <choice>Zero or one</choice>
            <choice>Zero or more</choice>
            <choice>Exactly one</choice>
        </choices>
    </question>

    <question id="13">
        <wording>What format does XML use?</wording>
        <choices>
            <choice correct="yes">Plain text</choice>
            <choice>Binary</choice>
            <choice>Compiled</choice>
            <choice>Encrypted</choice>
        </choices>
    </question>

    <question id="14">
        <wording>Which tag contains the whole test?</wording>
        <choices>
            <choice correct="yes">test</choice>
            <choice>exam</choice>
            <choice>quiz</choice>
            <choice>root</choice>
        </choices>
    </question>

    <question id="15">
        <wording>What is used to load XML with AJAX?</wording>
        <choices>
            <choice correct="yes">XMLHttpRequest</choice>
            <choice>fetchHTML</choice>
            <choice>loadXML</choice>
            <choice>importXML</choice>
        </choices>
    </question>

    <question id="16">
        <wording>Which method converts XML into DOM?</wording>
        <choices>
            <choice correct="yes">responseXML</choice>
            <choice>parseHTML</choice>
            <choice>toDOM</choice>
            <choice>xmlToTree</choice>
        </choices>
    </question>

    <question id="17">
        <wording>What is a node?</wording>
        <choices>
            <choice correct="yes">A unit of the DOM tree</choice>
            <choice>An HTML tag</choice>
            <choice>An XML file</choice>
            <choice>An attribute</choice>
        </choices>
    </question>

    <question id="18">
        <wording>What is AJAX?</wording>
        <choices>
            <choice correct="yes">A technique to load data without reloading the page</choice>
            <choice>A programming language</choice>
            <choice>A browser</choice>
            <choice>An XML editor</choice>
        </choices>
    </question>

    <question id="19">
        <wording>What does DOM mean?</wording>
        <choices>
            <choice correct="yes">Document Object Model</choice>
            <choice>Data Object Map</choice>
            <choice>Document Order Mode</choice>
            <choice>Dynamic Object Model</choice>
        </choices>
    </question>

    <question id="20">
        <wording>Which DTD attribute defines allowed values?</wording>
        <choices>
            <choice correct="yes">Enumeration</choice>
            <choice>List</choice>
            <choice>Selector</choice>
            <choice>Type</choice>
        </choices>
    </question>
</test>
